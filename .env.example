# ===================================================
# CẤU HÌNH ỨNG DỤNG THEO DÕI CHỨNG KHOÁN VIỆT NAM
# ===================================================

# Môi trường chạy (development / production)
APP_ENV=development
APP_PORT=8501

# Cấu hình cập nhật dữ liệu
AUTO_REFRESH_INTERVAL=10        # Số giây tự động làm mới bảng giá (Realtime Interval)
CACHE_EXPIRY_HOURS=2            # Thời gian hết hạn cache Parquet (giờ)

# Cấu hình danh mục cổ phiếu mặc định (ngăn cách bằng dấu phẩy)
DEFAULT_TICKERS=VNM,HPG,FPT,SSI,MWG,TCB,VHM,VIC

# Cấu hình đường dẫn lưu trữ TinyDB & Cache
TINYDB_PATH=data_store/watchlist.json
CACHE_DIR=data_store/cache

# Nguồn dữ liệu chứng khoán (VCI / TCBS / SSI)
DEFAULT_DATA_SOURCE=VCI
